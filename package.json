    "axios": "^1.7.9",
    "chalk": "^5.4.1",
    "chokidar": "^4.0.3",
    "file-type": "^19.6.0",
    "fluent-ffmpeg": "^2.1.3",
    "node-sqlite3-wasm": "^0.8.60",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.33.5",
    "zapo-js": "^1.8.2"
